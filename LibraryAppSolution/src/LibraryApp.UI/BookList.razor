@using LibraryApp.Core.DTOs
@using LibraryApp.Core.Interfaces
@inject IBookService BookService
@inject NavigationManager Navigation

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Book Catalog</h2>

            <!-- Search and Filters -->
            <div class="card mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="searchInput" class="form-label">Search</label>
                            <input type="text" class="form-control" id="searchInput"
                                   placeholder="Search by title, author, or category..."
                                   @bind="SearchTerm" />
                        </div>
                        <div class="col-md-3">
                            <label for="sortSelect" class="form-label">Sort By</label>
                            <select class="form-select" id="sortSelect" @bind="SortBy">
                                <option value="title">Title</option>
                                <option value="author">Author</option>
                                <option value="category">Category</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="orderSelect" class="form-label">Order</label>
                            <select class="form-select" id="orderSelect" @bind="SortOrder">
                                <option value="asc">Ascending</option>
                                <option value="desc">Descending</option>
                            </select>
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-primary w-100" @onclick="LoadBooks" @onclick:preventDefault @onclick:stopPropagation>
                                <i class="bi bi-search"></i> Search
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Loading State -->
            @if (IsLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading books...</p>
                </div>
            }
            else
            {
                <!-- Results Summary -->
                @if (Books != null && Books.Items.Any())
                {
                    <div class="mb-3">
                        <p class="text-muted">
                            Showing @Books.Items.Count() of @Books.TotalCount books
                            @if (!string.IsNullOrWhiteSpace(SearchTerm))
                            {
                                <span>for "@SearchTerm"</span>
                            }
                        </p>
                    </div>
                }

                <!-- Books Grid -->
                @if (Books != null && Books.Items.Any())
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                        @foreach (var book in Books.Items)
                        {
                            <div class="col">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title text-truncate" title="@book.Title">
                                            @book.Title
                                        </h5>
                                        <h6 class="card-subtitle mb-2 text-muted">
                                            by @book.Author
                                        </h6>
                                        <p class="card-text flex-grow-1">
                                            <small class="text-muted">
                                                <i class="bi bi-tag"></i> @book.Category.Name
                                            </small>
                                        </p>
                                        <div class="mt-auto">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="badge @(book.IsAvailable ? "bg-success" : "bg-warning")">
                                                    @(book.IsAvailable ? "Available" : "Borrowed")
                                                </span>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary btn-sm w-100"
                                                    @onclick="() => NavigateToBookDetails(book.Id)">
                                                View Details
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (Books.TotalPages > 1)
                    {
                        <nav aria-label="Book pagination">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Books.Page <= 1 ? "disabled" : "")">
                                    <span class="page-link" @onclick="() => ChangePage(Books.Page - 1)" style="cursor: pointer;" aria-disabled="@(Books.Page <= 1)">
                                        Previous
                                    </span>
                                </li>

                                @for (int i = Math.Max(1, Books.Page - 2); i <= Math.Min(Books.TotalPages, Books.Page + 2); i++)
                                {
                                    <li class="page-item @(i == Books.Page ? "active" : "")">
                                        <span class="page-link" @onclick="() => ChangePage(i)" style="cursor: pointer;">
                                            @i
                                        </span>
                                    </li>
                                }

                                <li class="page-item @(Books.Page >= Books.TotalPages ? "disabled" : "")">
                                    <span class="page-link" @onclick="() => ChangePage(Books.Page + 1)" style="cursor: pointer;" aria-disabled="@(Books.Page >= Books.TotalPages)">
                                        Next
                                    </span>
                                </li>
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <!-- No Results -->
                    <div class="text-center py-5">
                        <i class="bi bi-book display-1 text-muted"></i>
                        <h4 class="mt-3">No books found</h4>
                        <p class="text-muted">
                            @if (!string.IsNullOrWhiteSpace(SearchTerm))
                            {
                                <text>Try adjusting your search terms or</text>
                            }
                            <button type="button" class="btn btn-link p-0" @onclick="ClearSearch">
                                clear filters
                            </button>
                        </p>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private PaginatedResult<BookDto>? Books { get; set; }
    private bool IsLoading { get; set; } = true;
    private string SearchTerm { get; set; } = string.Empty;
    private string SortBy { get; set; } = "title";
    private string SortOrder { get; set; } = "asc";
    private int PageSize { get; set; } = 12; // 12 books per page for grid layout

    protected override async Task OnInitializedAsync()
    {
        await LoadBooks();
    }

    private async Task LoadBooks()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            Books = await BookService.GetBooksAsync(
                page: 1,
                pageSize: PageSize,
                search: string.IsNullOrWhiteSpace(SearchTerm) ? null : SearchTerm,
                sortBy: SortBy,
                sortOrder: SortOrder);
        }
        catch (Exception ex)
        {
            // In a real app, you'd log this and show a user-friendly error
            Console.WriteLine($"Error loading books: {ex.Message}");
            Books = new PaginatedResult<BookDto>
            {
                Items = new List<BookDto>(),
                TotalCount = 0,
                Page = 1,
                PageSize = PageSize,
                TotalPages = 0
            };
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > (Books?.TotalPages ?? 1))
            return;

        IsLoading = true;
        StateHasChanged();

        try
        {
            Books = await BookService.GetBooksAsync(
                page: page,
                pageSize: PageSize,
                search: string.IsNullOrWhiteSpace(SearchTerm) ? null : SearchTerm,
                sortBy: SortBy,
                sortOrder: SortOrder);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading books: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void NavigateToBookDetails(int bookId)
    {
        Navigation.NavigateTo($"/book/{bookId}");
    }

    private async Task ClearSearch()
    {
        SearchTerm = string.Empty;
        SortBy = "title";
        SortOrder = "asc";
        await LoadBooks();
    }
}